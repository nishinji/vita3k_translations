    <string name="settings_gpu_accuracy">Precisão de renderização</string>
    <string name="settings_gpu_accuracy_desc">Defina o nível de precisão do renderizador para o Vulkan. Alta precisão pode melhorar o visual, mas reduz o desempenho.</string>
    <string name="settings_gpu_accuracy_standard">Standard</string>
