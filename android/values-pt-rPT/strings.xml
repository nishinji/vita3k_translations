    <string name="settings_gpu_vsync">V-Sync</string>
    <string name="settings_gpu_vsync_desc">Ativar V-Sync para OpenGL. Reduz a desmontagem de tela.</string>
    <string name="settings_gpu_disable_surface_sync">Desativar Sincronização com Superfície</string>
    <string name="settings_gpu_disable_surface_sync_desc">Hack de velocidade, ao desativar desliga a sincronização de superfície entre CPU e GPU.\nA sincronização de superfície é necessária para alguns jogos.\nDá um grande aumento de desempenho se desativado (em particular, quando o aumento de escala está ligado).</string>
    <string name="settings_gpu_async_pipeline">Compilação assíncrona de Pipeline</string>
    <string name="settings_gpu_async_pipeline_desc">Permite que pipelines sejam compiladas simultaneamente em vários threads concorrentes.\nIsto diminui o travamento na compilação de pipeline ao custo de falhas gráficas temporárias.</string>
    <string name="settings_gpu_screen_filter">Filtro de ecrã</string>
    <string name="settings_gpu_screen_filter_desc">Selecione o filtro de imagem final a ser aplicado.</string>
    <string name="settings_gpu_resolution">Melhoria da Resolução Interna</string>
    <string name="settings_gpu_resolution_desc">Escala a resolução dos jogos por um multiplicador.\nExperimental: não é garantido que as aplicações renderizem normalmente a partir de 1x.</string>
    <string name="settings_gpu_resolution_val">%1$d\u00D7%2$d (%3$s\u00D7)</string>
    <string name="settings_gpu_anisotropic">Filtragem anisotrópica</string>
    <string name="settings_gpu_anisotropic_desc">Técnica para aumentar a nitidez das texturas que são inclinadas em relação ao espetador.\nNão tem desvantagens, mas pode afetar o desempenho em GPUs mais antigas.</string>
    <string name="settings_gpu_textures">Texturas</string>
    <string name="settings_gpu_export_textures">Exportar texturas</string>
    <string name="settings_gpu_export_textures_desc">Exportar texturas usadas pela aplicação para a pasta de texturas.</string>
    <string name="settings_gpu_import_textures">Importar texturas</string>
    <string name="settings_gpu_import_textures_desc">Importar texturas substituídas da pasta de texturas.</string>
    <string name="settings_gpu_texture_format">Formato de exportação de textura</string>
    <string name="settings_gpu_texture_format_desc">O formato para exportar as texturas</string>
    <string name="settings_gpu_fps_hack">Hack de FPS</string>
    <string name="settings_gpu_fps_hack_desc">Hack do jogo. Pode duplicar a taxa de quadros de 30 FPS para 60 FPS em alguns jogos,\nmas pode fazer com que alguns jogos corram duas vezes mais rápido.</string>
    <string name="settings_gpu_turbo_mode">Modo Turbo</string>
    <string name="settings_gpu_turbo_mode_desc">Fornece uma maneira de forçar a GPU a executar no máximo possível de clocks. Restrições térmicas ainda serão aplicadas.</string>
    <string name="settings_gpu_shader_cache">Habilitar cache de Shader</string>
    <string name="settings_gpu_shader_cache_desc">Habilitar caching de shader. Reduz travamento em execuções subsequentes.</string>
    <string name="settings_gpu_spirv_shader">Usar Shader SPIR-V (obsoleto)</string>
    <string name="settings_gpu_spirv_shader_desc">Passar um shader gerado pelo Spir-V diretamente para o driver.\nNote que algumas extensões benéficas serão desativadas e nem todos os GPUs são compatíveis com isto.</string>
